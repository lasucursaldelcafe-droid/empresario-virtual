# Empresario Virtual — Variables de entorno
# Copia este archivo: cp .env.example .env.local
# Luego ejecuta: npm run setup

# === Base de datos ===
# Local: SQLite en ./data/empresario.db
DATABASE_URL=./data/empresario.db

# Producción (Vercel + Turso): descomenta y usa en Vercel
# TURSO_DATABASE_URL=libsql://empresario-virtual-xxx.turso.io
# TURSO_AUTH_TOKEN=
# TURSO_PLATFORM_TOKEN=   # Turso → Settings → API Tokens (Windows / headless)
# TURSO_ORG=empresario-virtual

# URL pública (Vercel) — para CORS y OAuth redirect
# NEXT_PUBLIC_APP_URL=https://empresario-virtual.vercel.app

# === Seguridad (generada automáticamente por npm run setup) ===
ENCRYPTION_KEY=

# === Correo principal del empresario ===
MAIN_EMAIL=lasucursaldelcafe@gmail.com

# === Google OAuth (Gmail + Drive) — vía Google Cloud Console ===
# Guía: scripts/setup-google-cloud.md | npm run setup:google-oauth
# Proyecto recomendado: empresario-virtual
# https://console.cloud.google.com/apis/credentials?project=empresario-virtual
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# === Firebase (opcional — Auth/Firestore suplementario; Turso sigue siendo la BD principal) ===
# Proyecto: empresario-virtual | npm run setup:firebase
# FIREBASE_PROJECT_ID=empresario-virtual

# === OpenAI (opcional — enriquecimiento con IA) ===
OPENAI_API_KEY=

# === SMTP alternativo (solo si no usas OAuth) ===
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_APP_PASSWORD=

# === Configuración ===
APPROVAL_THRESHOLD=1000000
NODE_ENV=development
